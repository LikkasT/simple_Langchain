# 复制为.env.local后填写

#langsmith配置
LANGSMITH_API_KEY =
LANGSMITH_TRACING =true
LANGSMITH_ENDPOINT =https://api.smith.langchain.com
LANGSMITH_PROJECT ='simple-langchain'
# LLM配置
DEEPSEEK_API_KEY =
MODEL =deepseek-v4-flash
DEEPSEEK_BASE_URL =https://api.deepseek.com
MAX_TOKEN =
# 以下配置有默认值，不填则自动填默认值

#思考超时时间,单位为s
TINKING_TIMEOUT =30
#回答确定度，0为最确定，2为最随机(0,1,2)
TEMPERATURE =0
#是否流式输出(False,True)
STREAM =True
#重试次数
RETRY_NUM =2

